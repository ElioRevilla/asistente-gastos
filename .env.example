# Telegram Bot Token (get it from @BotFather)
TELEGRAM_TOKEN=

# Google Gemini API Key (get it from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# GCP Project ID
GCP_PROJECT_ID=asistente-gastos-bot

# Firestore database (leave as default unless you created a named database)
FIRESTORE_DATABASE=(default)

# Default currency for expenses (ISO 4217)
DEFAULT_CURRENCY=COP

# Default timezone for users
DEFAULT_TIMEZONE=America/Bogota

# Secret token to protect the /scheduler/daily-summary endpoint
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SCHEDULER_SECRET=

# Port (Cloud Run sets this automatically)
PORT=8080
